# MySQL connection used to store encrypted account blobs.
MYSQL_HOST=localhost
MYSQL_USER=gnosisvpn_accounts
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=gnosisvpn_accounts

# 32-byte (or any length) secret used to derive the AES-256-GCM key.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=change-me
