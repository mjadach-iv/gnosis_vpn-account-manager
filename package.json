{
  "name": "gnosis_vpn-account-manager",
  "version": "1.0.2",
  "description": "Manage and swap multiple Gnosis VPN accounts (HOPR identities) on one machine, backed by MySQL.",
  "type": "module",
  "bin": {
    "gvpn-accounts": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "clean": "rm -rf dist",
    "bundle": "esbuild src/index.js --bundle --platform=node --target=node22 --format=cjs --outfile=dist/index.cjs",
    "build": "scripts/build.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "pkg": {
    "targets": [
      "node22-linux-x64",
      "node22-linux-arm64",
      "node22-macos-arm64"
    ]
  },
  "license": "MIT",
  "devDependencies": {
    "@yao-pkg/pkg": "^6.3.0",
    "esbuild": "^0.24.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.2.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "js-yaml": "^4.1.0",
    "mysql2": "^3.11.0",
    "viem": "^2.52.2"
  }
}
